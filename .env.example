ANTHROPIC_API_KEY=
GROQ_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional - only needed if you wire up real WhatsApp/SMS/voice dispatch
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=
# A number verified on your Twilio account, used as the default destination
# for the real-call demo button in /admin.
TEST_PHONE_NUMBER=

# Optional - Sarvam AI text-to-speech (real Hinglish voice, not a generic
# English voice) for the fake-call demo UI. Falls back to the browser's own
# TTS if unset, so this is a quality upgrade, not a requirement.
SARVAM_API_KEY=
